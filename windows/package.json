{
  "name": "compositor-windows-zh",
  "version": "0.7.1",
  "description": "Compositor 中文 Windows 桌面版",
  "author": "Compositor contributors",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs && playwright test",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win portable nsis",
    "build:lite": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "dist:lite": "npm run build:lite && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-native.ps1",
    "test:lite": "node scripts/native-smoke.cjs",
    "prestart": "node scripts/sync-color-engine.cjs",
    "pretest": "node scripts/sync-color-engine.cjs",
    "prepack": "node scripts/sync-color-engine.cjs",
    "predist": "node scripts/sync-color-engine.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "buffer": "6.0.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.6",
    "lcms-wasm": "1.0.5"
  },
  "build": {
    "appId": "com.compositor.windows.zh",
    "productName": "Compositor 中文版",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "project.cjs",
      "image-metadata.cjs",
      "psd.cjs",
      "src/**/*",
      "assets/*",
      "LICENSE",
      "psd-effects.cjs",
      "psd-worker.cjs",
      "native/Fonts.cs",
      "native/fonts.ps1",
      "ai/**/*",
      "ai-service.cjs",
      "psd-adjustments.cjs",
      "cmyk-psd.cjs"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "artifactName": "Compositor-ZH-${version}-${arch}.${ext}",
    "portable": {
      "artifactName": "Compositor-ZH-${version}-${arch}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "Compositor-ZH-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "createDesktopShortcut": true
    },
    "compression": "normal",
    "asarUnpack": [
      "ai/**/*",
      "native/fonts.ps1",
      "native/Fonts.cs"
    ]
  },
  "dependencies": {
    "ag-psd": "31.0.3",
    "pngjs": "7.0.0"
  }
}
